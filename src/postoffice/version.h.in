#ifndef _VERSION_H
  #define _VERSION_H 1
  /* Generated by CMake from version.h.in. Do not edit. */
  #define __RELEASE "@PROJECT_VERSION@"
  #define __BUILD "@PO_BUILD_DATE@"
  #define __VERSION __RELEASE " build " __BUILD
  #define __VERSIONSTRING "Post Office " __VERSION
  #define __RELEASESTRING "Post Office " __RELEASE
  #define __CXXFLAGS "@PO_CXXFLAGS@"
  #define __UNAME "@CMAKE_SYSTEM_NAME@ @CMAKE_SYSTEM_VERSION@"
  #define __ARCH "@PO_ARCH@"
  /* Deliberately carries no user or host name: it ends up in the
     X-Mailer header of outgoing mail. */
  #define __BUILDINFO "Neo-PostOffice @PO_BUILD_TIMESTAMP@"

  extern const char *_VERSION, *_RELEASE, *_BUILD;
  extern const char *_VERSIONSTRING, *_RELEASESTRING, *_CXXFLAGS;
  extern const char *_UNAME, *_ARCH, *_BUILDINFO;
#endif
