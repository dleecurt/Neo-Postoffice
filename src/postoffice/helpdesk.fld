      code1 {o->label (__ARCH);}
    }
    Fl_Box {} {
      label Platform
      xywh {10 10 140 20} labelsize 12 align 24
    }
    Fl_Box {} {
      label {(kernel)}
      xywh {155 35 330 30} box THIN_DOWN_BOX color 51 labelsize 12 align 149
      code0 {\#include "version.h"}
      code1 {o->label (__UNAME);}
    }
    Fl_Box {} {
      label Kernel
      xywh {10 35 140 20} labelsize 12 align 24
    }
    Fl_Box {} {
      label {0.7.2 build 20000121}
      xywh {155 85 330 20} box THIN_DOWN_BOX color 51 labelsize 12 align 20
      code0 {\#include "version.h"}
      code1 {o->label (__VERSIONSTRING);}
    }
    Fl_Box {} {
      label {Application version}
