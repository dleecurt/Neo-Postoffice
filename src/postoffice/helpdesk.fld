    }
    Fl_Box {} {
      label {(build info)}
      xywh {155 120 330 20} box THIN_DOWN_BOX color 51 labelsize 12 align 20
      code0 {\#include "version.h"}
      code1 {o->label (__BUILDINFO);}
    }
    Fl_Box {} {
      label {Build Info}
