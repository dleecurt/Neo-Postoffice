Function {make_wizard()} {} {
  Fl_Window win_wizard {
    label {Post Office Installation Wizard} open
    xywh {721 585 680 372} type Single hide
  } {
    Fl_Group {} {open
      xywh {10 10 656 329} box UP_BOX color 51
    } {
      Fl_Button {} {
        image {icons/xbanner.xpm} compress_image 1 xywh {20 20 244 307} down_box UP_BOX
      }
      Fl_Group {} {
        xywh {273 20 380 307}
      } {
        Fl_Group gr_wiz01 {open
          xywh {273 20 380 307} box THIN_DOWN_BOX color 50
        } {
          Fl_Box {} {
            label {Welcome to Post Office.}
            xywh {283 30 360 20} labelfont 1 labelsize 18 align 149
          }
          Fl_Box {} {
            label {This seems to be the first time you run Post Office from this account. You will be guided through the initial setup of the client. In the process, a directory called '.postoffice' will be created in your homedir. If, at any time, you need a clean start with the program you can move this directory out of the way and this wizard will reappear upon startup.}
            xywh {283 55 355 140} labelsize 12 align 149
          }
          Fl_Group {} {open
            xywh {282 291 363 27}
          } {
            Fl_Box {} {
              label {Copyright (C) 1999 Mad Science Labs / Vuurwerk Internet}
              xywh {282 291 363 15} labelsize 10
            }
            Fl_Box {} {
              label {This program is available under the GNU General Public License}
              xywh {282 303 363 15} labelsize 10
            }
          }
        }
        Fl_Group gr_wiz02 {open
          xywh {273 20 380 307} box THIN_DOWN_BOX color 50 hide
        } {
          Fl_Input {} {
            label {Your Name}
            user_data {"postoffice/identities/001/realname"}
            callback cb_wiz_data
            xywh {413 30 230 20} labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Input {} {
            label {Your Organization}
            user_data {"postoffice/identities/001/organization"}
            callback cb_wiz_data
            xywh {413 55 230 20} labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Input {} {
            label {Your Email Address}
            user_data {"postoffice/identities/001/mailfrom"}
            callback cb_wiz_data
            xywh {413 95 230 20} labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Box {} {
            label {This information will be used to set up an 'Identity' in the program. The Email Address should be one you can receive mail on. You can add more identities or change the default one from the configuration panel under "Identities".}
            xywh {283 130 360 70} labelsize 12 align 149
          }
          Fl_Group {} {open
            xywh {282 291 363 27}
          } {
            Fl_Box {} {
              label {Copyright (C) 1999 Mad Science Labs / Vuurwerk Internet}
              xywh {282 291 363 15} labelsize 10
            }
            Fl_Box {} {
              label {This program is available under the GNU General Public License}
              xywh {282 303 363 15} labelsize 10
            }
          }
        }
        Fl_Group gr_wiz03 {open
          xywh {273 20 380 307} box THIN_DOWN_BOX color 50 hide
        } {
          Fl_Input {} {
            label {Autoconfig URL}
            user_data {"tmp/autoconfig"}
            callback cb_wiz_data
            xywh {408 30 230 20} labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Box {} {
            label {Autoconfig is a convenient way to distribute general settings department- or company-wide. If Post Office is widely used inside your company, you may want to ask your system administrator for this url. In other cases you can leave this empty.}
            xywh {283 70 355 125} labelsize 12 align 149
          }
          Fl_Group {} {open
            xywh {282 291 363 27}
          } {
            Fl_Box {} {
              label {Copyright (C) 1999 Mad Science Labs / Vuurwerk Internet}
              xywh {282 291 363 15} labelsize 10
            }
            Fl_Box {} {
              label {This program is available under the GNU General Public License}
              xywh {282 303 363 15} labelsize 10
            }
          }
        }
        Fl_Group gr_wiz04 {open
          xywh {273 20 380 307} box THIN_DOWN_BOX color 50 hide
        } {
          Fl_Input {} {
            label {POP3 Hostname}
            user_data {"postoffice/mailboxes/Personal/host"}
            callback cb_wiz_data
            xywh {413 30 230 20} labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Input {} {
            label Username
            user_data {"postoffice/mailboxes/Personal/user"}
            callback cb_wiz_data
            xywh {413 55 100 20} labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Input {} {
            label Password
            user_data {"postoffice/mailboxes/Personal/pass"}
            callback cb_wiz_data
            xywh {413 80 100 20} type Secret labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Box {} {
            label {This will create the POP3 mailbox. If you keep the password empty the program will prompt for it when it first contacts the host during a session. No POP3 box will be created if you leave these fields empty.}
            xywh {283 115 360 80} labelsize 12 align 149
          }
          Fl_Group {} {open
            xywh {282 291 363 27}
          } {
            Fl_Box {} {
              label {Copyright (C) 1999 Mad Science Labs / Vuurwerk Internet}
              xywh {282 291 363 15} labelsize 10
            }
            Fl_Box {} {
              label {This program is available under the GNU General Public License}
              xywh {282 303 363 15} labelsize 10
            }
          }
        }
        Fl_Group gr_wiz05 {open
          xywh {273 20 380 307} box THIN_DOWN_BOX color 50 hide
        } {
          Fl_Input {} {
            label {NNTP Server}
            user_data {"postoffice/mailboxes/Usenet/host"}
            callback cb_wiz_data
            xywh {413 30 230 20} labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Input {} {
            label Username
            user_data {"postoffice/mailboxes/Usenet/user"}
            callback cb_wiz_data
            xywh {413 55 100 20} labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Input {} {
            label Password
            user_data {"postoffice/mailboxes/Usenet/pass"}
            callback cb_wiz_data
            xywh {413 80 100 20} type Secret labelfont 1 labelsize 12 when 1 textsize 12
          }
          Fl_Box {} {
            label {This will set up your connection to the Usenet newsgroup facility. If you don't intend to read newsgroups, you can keep this all empty. If no username is filled in, no authentication will be used. If the password is left blank, you will be prompted for it upon connect.}
            xywh {283 115 360 80} labelsize 12 align 149
          }
          Fl_Group {} {open
            xywh {282 291 363 27}
          } {
            Fl_Box {} {
              label {Copyright (C) 1999 Mad Science Labs / Vuurwerk Internet}
              xywh {282 291 363 15} labelsize 10
            }
            Fl_Box {} {
              label {This program is available under the GNU General Public License}
              xywh {282 303 363 15} labelsize 10
            }
          }
        }
        Fl_Group gr_wiz06 {open
          xywh {273 20 380 307} box THIN_DOWN_BOX color 50 hide
        } {
          Fl_Box {} {
            label {These checkboxes will create a few convenient settings for the incoming mailbox. Extra mailfolders and filters can be created to seperate incoming messages if they are related to mailinglists, or if they are bounces. Don't turn on automatic mailchecking if you want to be able to run Post Office in offline mode.}
            xywh {283 100 360 95} labelsize 12 align 149
          }
          Fl_Check_Button {} {
            label {Seperate folder for lists}
            user_data {"tmp/listfolder"}
            callback cb_wiz_check
            xywh {283 30 180 20} down_box DIAMOND_DOWN_BOX selection_color 7 labelsize 12
            code0 {\#include "maccheck.h"}
            class Fl_MacCheck_Button
          }
          Fl_Check_Button {} {
            label {Seperate folder for bounces}
            user_data {"tmp/bouncefolder"}
            callback cb_wiz_check
            xywh {283 50 180 20} down_box DIAMOND_DOWN_BOX selection_color 7 labelsize 12
            code0 {\#include "maccheck.h"}
            class Fl_MacCheck_Button
          }
          Fl_Check_Button {} {
            label {Automatically check mail}
            user_data {"tmp/autocheck"}
            callback cb_wiz_check
            xywh {283 70 180 20} down_box DIAMOND_DOWN_BOX selection_color 7 labelsize 12
            code0 {\#include "maccheck.h"}
            class Fl_MacCheck_Button
          }
          Fl_Group {} {open
            xywh {282 291 363 27}
          } {
            Fl_Box {} {
              label {Copyright (C) 1999 Mad Science Labs / Vuurwerk Internet}
              xywh {282 291 363 15} labelsize 10
            }
            Fl_Box {} {
              label {This program is available under the GNU General Public License}
              xywh {282 303 363 15} labelsize 10
            }
          }
        }
      }
    }
    Fl_Group {} {open
      xywh {522 343 70 20} box BORDER_BOX
    } {
      Fl_Button bt_wiz_next {
        label {Next >}
        callback cb_wiz_next
        xywh {524 345 68 18} labelsize 12
      }
    }
    Fl_Group {} {open
      xywh {10 343 70 20} box BORDER_BOX
    } {
      Fl_Button bt_wiz_prev {
        label {< Prev}
        callback cb_wiz_prev
        xywh {12 345 68 18} labelsize 12 deactivate
      }
    }
    Fl_Group {} {open
      xywh {597 343 70 20} box BORDER_BOX
    } {
      Fl_Button bt_wiz_finish {
        label Finish
        callback cb_wiz_finish
        xywh {599 345 68 18} labelsize 12 deactivate
      }
    }
  }
}

Function {make_aboot()} {} {
  Fl_Window win_aboot {
    label {About Post Office} open
    xywh {891 716 239 299} type Single hide modal
  } {
