    } {
      Fl_Group {} {open
        xywh {14 18 211 261}
      } {
        Fl_Group {} {open
          xywh {30 63 180 107}
        } {
          Fl_Box {} {
            label {Main Development}
            xywh {30 63 180 15} labelsize 12 align 16
          }
          Fl_Box {} {
            label {Pim van Riezen}
            xywh {30 78 180 15} labelfont 1 labelsize 12 align 16
          }
          Fl_Box {} {
            label {Special Ops & Architecture Cop}
            xywh {30 102 180 15} labelsize 12 align 16
          }
          Fl_Box {} {
            label {Vadim Kogan}
            xywh {30 117 180 15} labelfont 1 labelsize 12 align 16
          }
          Fl_Box {} {
            label {IMAP4 & Stuff}
            xywh {30 140 180 15} labelsize 12 align 16
          }
          Fl_Box {} {
            label {Eric the Pezking}
            xywh {30 155 180 15} labelfont 1 labelsize 12 align 16
          }
        }
        Fl_Box {} {
          label {Post Office 0.7.2}
          xywh {24 24 189 33} labelfont 1 labelsize 18
          code0 {\#include "version.h"}
          code1 {o->label (__RELEASESTRING);}
        }
