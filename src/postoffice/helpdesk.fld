        }
      }
    }
  }
}

Function {make_buildinfo()} {} {
  Fl_Window win_buildinfo {
    label {Build Congiruration} open
    xywh {469 281 498 207} type Single hide
  } {
    Fl_Box {} {
      label {linux2.2-x86-glibc2.1-gnuegcs2.91}
      xywh {155 10 330 20} box THIN_DOWN_BOX color 51 labelsize 12 align 20
