      code1 {o->label (__CXXFLAGS);}
    }
    Fl_Box {} {
      label CXXFLAGS
      xywh {10 145 140 20} labelsize 12 align 24
    }
    Fl_Group {} {open
      xywh {390 175 95 20} box BORDER_BOX
    } {
      Fl_Button {} {
        label {Bug Report}
        callback cb_bugreport
        xywh {392 177 93 18} labelsize 12
      }
    }
  }
}

