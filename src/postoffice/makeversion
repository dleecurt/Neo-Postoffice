#!/bin/sh
ARCH="$1"
CXXFLAGS="$2"
BUILDVERS=`date +%Y%m%d`
UNAME=`uname -a`
BUILDUSER=`whoami`
BUILDHOST=`hostname`
BUILDDATE=`date +"%Y\/%m\/%d %H:%M:%S"`
BUILDINFO="$BUILDUSER@$BUILDHOST $BUILDDATE"
cat version.h.in | sed -e "s/\.BUILD\./$BUILDVERS/" \
  | sed -e "s/\.CXXFLAGS\./$CXXFLAGS/" \
  | sed -e "s/\.ARCH\./$ARCH/" \
  | sed -e "s/\.UNAME\./$UNAME/" \
  | sed -e "s/\.CXXFLAGS\./$CXXFLAGS/" \
  | sed -e "s/\.BUILDINFO\./$BUILDINFO/" > version.h
