all: ../../lib/arch/$(ARCH)/librcledit.a \
	 ../../lib/arch/$(ARCH)/librcl.a

clean::
	rm -f arch/$(ARCH)/*.o;
	rm -f ../../lib/$(ARCH)/librcl*.a;
	rm -f `find . -name core`

../../lib/arch/$(ARCH)/librcledit.a:	arch/$(ARCH)/Fl_Editor.o\
	arch/$(ARCH)/Fl_MultiEditor.o\
	arch/$(ARCH)/Fl_FancyEditor.o\
	arch/$(ARCH)/Fl_FancyMultiEditor.o\
	arch/$(ARCH)/Fl_StatusPanel.o\
	arch/$(ARCH)/Fl_ProgressBox.o
	$(AR) -cr $@ \
	arch/$(ARCH)/Fl_Editor.o \
	arch/$(ARCH)/Fl_FancyEditor.o \
	arch/$(ARCH)/Fl_FancyMultiEditor.o \
	arch/$(ARCH)/Fl_StatusPanel.o \
	arch/$(ARCH)/Fl_ProgressBox.o \
	arch/$(ARCH)/Fl_MultiEditor.o

../../lib/arch/$(ARCH)/librcl.a: \
	arch/$(ARCH)/edfile.o\
	arch/$(ARCH)/engappd.o\
	arch/$(ARCH)/engbsdel.o\
	arch/$(ARCH)/engclear.o\
	arch/$(ARCH)/engcmd.o\
	arch/$(ARCH)/engcursr.o\
	arch/$(ARCH)/engdeol.o\
	arch/$(ARCH)/engfind.o\
	arch/$(ARCH)/engfmt.o\
	arch/$(ARCH)/engine.o\
	arch/$(ARCH)/enginsch.o\
	arch/$(ARCH)/enginsl.o\
	arch/$(ARCH)/englfit.o\
	arch/$(ARCH)/engrcopy.o\
	arch/$(ARCH)/engrdel.o\
	arch/$(ARCH)/engreml.o\
	arch/$(ARCH)/engrpast.o\
	arch/$(ARCH)/engsortp.o\
	arch/$(ARCH)/lists.o\
	arch/$(ARCH)/powten.o\
	arch/$(ARCH)/commdel.o\
	arch/$(ARCH)/stextrac.o\
	arch/$(ARCH)/stjust.o\
	arch/$(ARCH)/strepeat.o\
	arch/$(ARCH)/strings.o\
	arch/$(ARCH)/ststrip.o\
	arch/$(ARCH)/stwords.o
	rm -f $@; $(AR) -cr $@ \
	arch/$(ARCH)/edfile.o \
	arch/$(ARCH)/engappd.o \
	arch/$(ARCH)/engbsdel.o \
	arch/$(ARCH)/engclear.o \
	arch/$(ARCH)/engcmd.o \
	arch/$(ARCH)/engcursr.o \
	arch/$(ARCH)/engdeol.o \
	arch/$(ARCH)/engfind.o \
	arch/$(ARCH)/engfmt.o \
	arch/$(ARCH)/engine.o \
	arch/$(ARCH)/enginsch.o \
	arch/$(ARCH)/enginsl.o \
	arch/$(ARCH)/englfit.o \
	arch/$(ARCH)/engrcopy.o \
	arch/$(ARCH)/engrdel.o \
	arch/$(ARCH)/engreml.o \
	arch/$(ARCH)/engrpast.o \
	arch/$(ARCH)/engsortp.o \
	arch/$(ARCH)/lists.o \
	arch/$(ARCH)/powten.o \
	arch/$(ARCH)/commdel.o \
	arch/$(ARCH)/stextrac.o \
	arch/$(ARCH)/stjust.o \
	arch/$(ARCH)/strepeat.o \
	arch/$(ARCH)/strings.o \
	arch/$(ARCH)/ststrip.o \
	arch/$(ARCH)/stwords.o

