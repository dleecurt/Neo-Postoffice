include ../../config/config.$(HOST)

OBJFILES = \
	arch/$(ARCH)/Fl_Toggle_Tree_Base.o \
	arch/$(ARCH)/Fl_Toggle_Node_Base.o \
	arch/$(ARCH)/Fl_Toggle_Node.o \
	arch/$(ARCH)/Fl_Toggle_Tree.o

CFILES = 

CLEAN =

OBJECTS = $(CPPFILES:.cxx=.o) $(CFILES:.c=.o)

all : ../../lib/arch/$(ARCH)/libtoggletree.a

../../lib/arch/$(ARCH)/libtoggletree.a: $(OBJFILES)
	ar cr ../../lib/arch/$(ARCH)/libtoggletree.a $(OBJFILES)
.SUFFIXES:	.cxx .h .o

arch/$(ARCH)/Fl_Toggle_Tree_Base.o: Fl_Toggle_Tree_Base.cxx
	$(CXX) $(CXXFLAGS) -I../../include -c Fl_Toggle_Tree_Base.cxx -o arch/$(ARCH)/Fl_Toggle_Tree_Base.o

arch/$(ARCH)/Fl_Toggle_Node_Base.o: Fl_Toggle_Node_Base.cxx
	$(CXX) $(CXXFLAGS) -I../../include -c Fl_Toggle_Node_Base.cxx -o arch/$(ARCH)/Fl_Toggle_Node_Base.o

arch/$(ARCH)/Fl_Toggle_Node.o: Fl_Toggle_Node.cxx
	$(CXX) $(CXXFLAGS) -I../../include -c Fl_Toggle_Node.cxx -o arch/$(ARCH)/Fl_Toggle_Node.o

arch/$(ARCH)/Fl_Toggle_Tree.o: Fl_Toggle_Tree.cxx
	$(CXX) $(CXXFLAGS) -I../../include -c Fl_Toggle_Tree.cxx -o arch/$(ARCH)/Fl_Toggle_Tree.o

clean:
	-@ rm -f arch/$(ARCH)/*.o $(LIBRARY) $(CLEAN) core *~
	@touch makedepend

distclean: clean
	-@ rm -f config.* makeinclude

