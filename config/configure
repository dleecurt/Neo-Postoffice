#!/usr/bin/perl

$HOSTNAME=`uname -n | cut -f 1 -d .`;
chop($HOSTNAME);

print "Configuring build for ";
print $HOSTNAME;
print "\n";

$OS=`uname -s`;
chop($OS);

print "\n --- Verifying dependencies ---\n\n";

@PACKAGES=`(cd pkg && ls -1 *.spkg | cut -f 1 -d . | cut -f 2 -d "_")`;

foreach $pkg (@PACKAGES)
{
	chop($pkg);
	$zpkg=`(cd pkg && ls -1 ??_$pkg.dep)`;
	chop($zpkg);
	
	if (-e "pkg/$zpkg")
	{
		open (FIL,"pkg/$zpkg");
		while (<FIL>)
		{
			$TDEP = $_;
			chop ($TDEP);
			$fdep = 0;
			foreach $xpkg (@PACKAGES)
			{
				if ($xpkg eq $TDEP)
				{
					$fdep = 1;
				}
			}
			if ($fdep == 0)
			{
				print "Failed dependency: $pkg needs $TDEP\n";
				exit 1;
			}
		}
		close (FIL);
	}
	print "$pkg passed dependency test\n";
}

print "\n --- Configuring compiler/linker ---\n\n";

if (! -e "config/config.$HOSTNAME")
{
	# ==============================================================================================
	# IRIX configuration
	# ==============================================================================================
	#
	# IRIX6.2 and upwards are supported, both with GNU and SGI compilers.
	#

	if ($OS eq "IRIX") {

	  # --- Determine IRIX version through uname

	  print "Checking IRIX version...\n";

	  $OS = "irix";

	  $RELEASE=`uname -r`;

	  if ($RELEASE eq "6.2")
	  {
    	       print "\nWarning: IRIX 6.2 is only supported with the POSIX patchset installed\n\n";
	  }
	  if ($RELEASE < 6.2)
	  {
    	       print "\nError: IRIX ";
	       print $RELEASE;
	       print "is not supported\n\n";
    	exit;
	  }

	  # --- Determine MIPS CPU type through hinv

	  print "Checking CPU type...\n";

	  $CPU=`hinv | egrep "^CPU:" | cut -f 3 -d " "`;
	  chop($CPU);

	  # --- Derive MIPS ABI from CPU type

	  print "Configuring MIPS ABI...\n";

	  if (($CPU eq "R5000")||($CPU eq "R10000")||($CPU eq "R12000")||($CPU eq "R14000"))
	  {
  		$MABI="n32";
  		$BINTYPE="mips4";
	  }
	  elsif (($CPU eq "R4000")||($CPU eq "R4400")||($CPU eq "RR4600"))
	  {
  		$MABI="n32";
  		$BINTYPE="mips3";
	  }
	  else
	  {
    	 print "\nError: unsupported CPU type " . $CPU . ", aborting.\n";
		 exit;
	  }

	  # --- Scan install database for c++_dev subsystem

	  print "Checking for SGI C++ Development option...\n";

	  $MIPSPRO_INSTALLED=`versions c++_dev | egrep \"\^I\" | grep -v \"Removed\" | wc -l`;

	  if ($MIPSPRO_INSTALLED>0)
	  {
  		$CXX="CC";
		$CXXVERSION=`CC -version 2>&1 | cut -f 4 -d " " | cut -f 1,2 -d .`;
		$CXXTYPE="sgi";
		chop($CXXVERSION);
		$CXXFLAGS="-DUSE_GDBM -g -DIRIX -O3 -" . $BINTYPE . " -" . $MABI;
	  }
	  else
	  {
  		$CXX="g++";
    	$CXXVERSION = `g++ -v 2>&1 | grep "gcc version" | cut -f 3 -d " " | cut -f 1,2 -d .`;
		$CXXTYPE="gnu";
    	chop($CXXVERSION);
		$CXXFLAGS="-DUSE_GDBM -g -DIRIX -O3 -mabi=" . $MABI . " -" . $BINTYPE;
	  }

	  chop($RELEASE);


	  $GLIBC = "libc";
	  $GLIBC_TYPE = "sgi";
	  $CPUABI = $MABI . "_" . $BINTYPE;

	  $LIBDL = "";
	  $LIBPTHREAD = "-lpthread";
	  $LIBCRYPT = "";
	  $LIBRESOLV = "";
	  $SHAREDFLAGS = "-shared";

	  $ARCH = $OS . $RELEASE . "-" . $CPUABI . "-" . $GLIBC_TYPE . $GLIBC . "-" . $CXXTYPE . $CXXVERSION;

	}



	# ==============================================================================================
	# Solaris configuration
	# ==============================================================================================
	#
	# So far I only tested SunOS5.7 with gcc
	#

	elsif ($OS eq "SunOS") {

	  # --- Determine IRIX version through uname

	  print "Checking IRIX version...\n";

	  $OS = "solaris";

	  $RELEASE=`uname -r`;
	  chop($RELEASE);

	  if ($RELEASE < 5,7)
	  {
    	print "\nWarning: SunOS ";
		print $RELEASE;
		print "is not tested\n\n";
	  }

	  # --- Determine MIPS CPU type through hinv

	  print "Checking CPU architecture...\n";
	  $CPU=`uname -p`;
	  chop($CPU);

  		$CXX="g++";
    	$CXXVERSION = `g++ -v 2>&1 | grep "gcc version" | cut -f 3 -d " " | cut -f 1,2 -d .`;
		$CXXTYPE="gnu";
    	chop($CXXVERSION);
		$CXXFLAGS="-DUSE_GDBM -g -DSOLARIS -O3";

	  print "Checking Machine architecture...\n";
	  $HW=`uname -m`;
	  chop($HW);

	  $CPUABI = $CPU . "-" . $HW;

	  $GLIBC = "libc";
	  $GLIBC_TYPE = "sun";

	  $LIBDL = "-ldl";
	  $LIBPTHREAD = "-lpthread";
	  $LIBCRYPT = "";
	  $LIBRESOLV = "-lnsl -lsocket";
	  $SHAREDFLAGS = "-shared";

	  $ARCH = $OS . $RELEASE . "-" . $CPUABI . "-" . $GLIBC_TYPE . $GLIBC . "-" . $CXXTYPE . $CXXVERSION;

	}




	# ==============================================================================================
	# Linux configuration
	# ==============================================================================================
	#
	# Only linux2.0 kernels and upwards are known to work correctly. We need a working
	# native implementation of Posix Threads.
	#

	elsif ($OS eq "Linux")
	{
	  # --- Determine kernel version through uname

	  $OS="linux";

	  print "Checking Linux Kernel version...\n";
	  $RELEASE_MAJOR=`uname -r | cut -f 1 -d .`;
	  $RELEASE_MINOR=`uname -r | cut -f 2 -d .`;
	  chop($RELEASE_MAJOR);
	  chop($RELEASE_MINOR);
	  if ($RELEASE_MAJOR<2)
	  {
  		print "Error: 1.x.x series kernels not supported\n";
  		exit;
	  }

	  # --- Determine CPU through uname

	  print "Checking CPU type...\n";
	  $CPU=`uname -m | sed -e "s/i.86/x86/"`;
	  chop($CPU);

	  # --- Detect RedHat through rpm

	  print "Checking for RedHat distribution...\n";

	  $WHICHRPM=`which rpm`;
	  chop($WHICHRPM);

	  if (($WHICHRPM eq "/usr/bin/rpm") || ($WHICHRPM eq "/bin/rpm"))
	  {
  		$HASRPM="YES";
  		$DISTRIBUTION="RedHat";
  		print "Checking GNU libc version...\n";
  		$GLIBC_MAJOR=`rpm -q glibc 2>/dev/null | cut -f 2 -d "-" | cut -f 1 -d .`;
  		$GLIBC_MINOR=`rpm -q glibc 2>/dev/null | cut -f 2 -d "-" | cut -f 2 -d .`;
  		chop($GLIBC_MAJOR);
		chop($GLIBC_MINOR);
		$GLIBC_TYPE="glibc";

		if ($GLIBC_MAJOR eq "")
		{
	  		$GLIBC_MAJOR=`rpm -q libc 2>/dev/null | cut -f 2 -d "-" | cut -f 1 -d .`;
	  		$GLIBC_MINOR=`rpm -q libc 2>/dev/null | cut -f 2 -d "-" | cut -f 2 -d .`;
			chop($GLIBC_MAJOR);
			chop($GLIBC_MINOR);
			$GLIBC_TYPE="libc";
		}

		if ($GLIBC_MAJOR eq "")
		{
			print "Most probably this isn't RedHat...\n";
			$GLIBC_MAJOR=`(cd /lib && ls -1 libc-2.*.*.so) | head -1 | cut -f 2 -d "-" | cut -f 1 -d .`;
			$GLIBC_MINOR=`(cd /lib && ls -1 libc-2.*.*.so) | head -1 | cut -f 2 -d "-" | cut -f 2 -d .`;
			chop ($GLIBC_MAJOR);
			chop ($GLIBC_MINOR);			
			$GLIBC_TYPE="glibc";
		}
	  }
	  else
	  {
		print "Most probably this isn't RedHat...\n";
		$GLIBC_MAJOR=`(cd /lib && ls -1 libc-2.*.*.so) | head -1 | cut -f 2 -d "-" | cut -f 1 -d .`;
		$GLIBC_MINOR=`(cd /lib && ls -1 libc-2.*.*.so) | head -1 | cut -f 2 -d "-" | cut -f 2 -d .`;
		chop ($GLIBC_MAJOR);
		chop ($GLIBC_MINOR);			
		$GLIBC_TYPE="glibc";
	  }

	  $RELEASE = $RELEASE_MAJOR . "." . $RELEASE_MINOR;

	  print "Checking compiler version...\n";

	  $CXXVERSION = `g++ -v 2>&1 | grep "gcc version" | cut -f 3 -d " " | cut -f 1,2 -d . | sed -e "s/\-//"`;
	  chop($CXXVERSION);

	  $CPUABI = $CPU;
	  $CXXFLAGS = "-DUSE_GDBM -Wall -g -O2 -DLINUX";
	  $CXXTYPE = "gnu";
	  $CXX = "g++";
	  $LIBDL = "-ldl";
	  $LIBPTHREAD = "-lpthread";
	  $LIBCRYPT = "-lcrypt";
	  $LIBRESOLV = "";
	  $SHAREDFLAGS = "-shared";
	  $GLIBC = $GLIBC_MAJOR . "." . $GLIBC_MINOR;

	  $ARCH = $OS . $RELEASE . "-" . $CPUABI . "-" . $GLIBC_TYPE . $GLIBC . "-" . $CXXTYPE . $CXXVERSION;
	}




	else
	{
	  print "Unknown OS type: ";
	  print $OS;
	  print "..\n";
	  exit;
	}
	
	print "\n--- Global configure complete ---\n\n";
	$DATE = `date`;
	chop($DATE);

	open (CF,">config/config.$HOSTNAME");
	print CF "# Configuration for $HOSTNAME\n";
	print CF "# Created $DATE\n";
	print CF "\n";
	print CF "ARCH        = " . $ARCH . "\n";
	print CF "CXX         = " . $CXX . "\n";
	print CF "CXXFLAGS    = " . $CXXFLAGS . "\n";
	print CF "LIBDL       = " . $LIBDL . "\n";
	print CF "LIBCRYPT    = " . $LIBCRYPT . "\n";
	print CF "LIBPTHREAD  = " . $LIBPTHREAD . "\n";
	print CF "LIBRESOLV   = " . $LIBRESOLV . "\n";
	print CF "SHAREDFLAGS = " . $SHAREDFLAGS . "\n";
	close (CF);
}
else
{
	print "\n --- Using cached configfile ---\n\n";
	$CONFIGFILE="config/config.$HOSTNAME";
	$ARCH=`cat $CONFIGFILE | grep "^ARCH" | cut -f 2 -d "=" | cut -f 2 -d " "`;
	chop($ARCH);
}

if (! -e "config")
{
	system "mkdir config";
}

system "cat config/config.$HOSTNAME";

print "\nCreating arch entries for $ARCH\n";

if (! -e "vroot")
{
	system "mkdir vroot";
}

open (PKG,"cd pkg && ls -1 *.spkg |");
while (<PKG>)
{
	$PKGDIR=`cat pkg/$_`;
	chop($PKGDIR);
	if (! -e "$PKGDIR/arch")
	{
		system "mkdir $PKGDIR/arch";
	}
	if (! -e "$PKGDIR/arch/$ARCH")
	{
		system "mkdir $PKGDIR/arch/$ARCH";
		system "mkdir $PKGDIR/arch/$ARCH/include";
	}
}
close (PKG);

if (! -e "lib")
{
	system "mkdir lib";
}
if (! -e "lib/arch")
{
	system "mkdir lib/arch";
}
if (! -e "lib/arch/$ARCH")
{
	system "mkdir lib/arch/$ARCH";
}
if (! -e "bin")
{
	system "mkdir bin";
}
if (! -e "bin/arch")
{
	system "mkdir bin/arch";
}
if (! -e "bin/arch/$ARCH")
{
	system "mkdir bin/arch/$ARCH";
}
if (! -e "drivers")
{
	system "mkdir drivers";
}
if (! -e "drivers/arch")
{
	system "mkdir drivers/arch";
}
if (! -e "drivers/arch/$ARCH")
{
	system "mkdir drivers/arch/$ARCH";
}

if (! -e "vroot/$HOSTNAME")
{
	print "Creating vroot for $HOSTNAME\n";
	system "mkdir vroot/$HOSTNAME";
	system "ln -s ../../bin/arch/$ARCH vroot/$HOSTNAME/bin";
	system "ln -s ../../lib/arch/$ARCH vroot/$HOSTNAME/lib";
	system "ln -s ../../drivers/arch/$ARCH vroot/$HOSTNAME/drivers";
	system "ln -s ../../htdocs vroot/$HOSTNAME/htdocs";
	system "mkdir vroot/$HOSTNAME/etc";
	system "mkdir vroot/$HOSTNAME/var";
}

if (-e "skel/etc")
{
	open (SKEL, "ls -1 skel/etc/ |");
	while (<SKEL>)
	{
		$SF="$_";
		chop($SF);
		system "cat skel/etc/$SF | sed -e 's/\$HOSTNAME/$HOSTNAME/' > vroot/$HOSTNAME/etc/$SF";
	}
	close (SKEL);
}
if (-e "skel/vroot")
{
	system "cp -r skel/vroot/* vroot/$HOSTNAME/";
}

@CONFSCRIPTS=`(cd pkg && ls -1 *.conf 2>/dev/null)`;

	print "\n --- Running package-specific configure scripts ---\n\n";

	foreach $cnf (@CONFSCRIPTS)
	{
		system "ARCH=$ARCH && export ARCH && pkg/$cnf";
	}

print "\n --- All configuration complete ---\n";
